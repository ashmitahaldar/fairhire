generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  manager
  hr_admin
}

enum DecisionOutcome {
  hired
  rejected
  in_progress
  promoted
  held
}

enum MeetingType {
  hiring
  promotion
}

enum AnalysisStatus {
  pending
  running
  completed
  failed
}

enum FlagType {
  biased_language
  criteria_drift
  asymmetric_concern
  hedging_language
  age_bias
  potential_vs_performance
  tenure_framing
  peer_comparison_bias
  confidence_proxy
}

enum NationalityStatus {
  citizen
  pr
  ep_holder
  s_pass
  other
}

enum Race {
  chinese
  malay
  indian
  other
}

// Enum values cannot start with a digit in Prisma
enum AgeBand {
  under_30
  age_30_39
  age_40_49
  age_50_plus
}

enum Gender {
  male
  female
  non_binary
  prefer_not_to_say
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organisation {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  departments  Department[]
  managers     Manager[]
  candidates   Candidate[]
  meetings     Meeting[]
  decisions    Decision[]
  flags        Flag[]
  analysisRuns AnalysisRun[]

  @@map("organisations")
}

model Department {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  org      Organisation @relation(fields: [orgId], references: [id])
  managers Manager[]

  @@index([orgId])
  @@map("departments")
}

model Manager {
  id          String   @id @default(uuid())
  clerkUserId String   @unique @map("clerk_user_id")
  orgId       String   @map("org_id")
  deptId      String   @map("dept_id")
  role        Role     @default(manager)
  name        String
  email       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org           Organisation @relation(fields: [orgId], references: [id])
  dept          Department   @relation(fields: [deptId], references: [id])
  meetings      Meeting[]
  decisions     Decision[]
  dismissedFlags Flag[]      @relation("DismissedBy")

  @@index([orgId])
  @@map("managers")
}

model Candidate {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  name           String
  roleAppliedFor String    @map("role_applied_for")
  createdAt      DateTime  @default(now()) @map("created_at")
  // Soft-delete marker. List endpoints filter on deletedAt: null so a
  // candidate that has linked meetings/flags/decisions can be hidden
  // without orphaning analysis history. NULL = active.
  deletedAt      DateTime? @map("deleted_at")

  // Promotion-mode fields. Reused Candidate row for both hiring and
  // promotion (Section 3 of the Week 5 plan): for promotion uploads the
  // employee is a Candidate with roleAppliedFor = target level/role, and
  // these three fields capture their current state. Null for hiring
  // candidates.
  currentRole    String?   @map("current_role")
  tenureYears    Int?      @map("tenure_years")
  lastPromotedAt DateTime? @map("last_promoted_at")

  org          Organisation           @relation(fields: [orgId], references: [id])
  meetings     MeetingCandidate[]
  decisions    Decision[]
  demographics CandidateDemographics?

  // Composite unique target for CandidateDemographics' (candidate_id, org_id)
  // FK — lets that FK pin a demographics row to a candidate in the same org.
  @@unique([id, orgId])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@map("candidates")
}

// Separated from `candidates` so protected/self-reported attributes can be
// access-controlled independently (e.g. fairness aggregates available to
// audit roles while individual managers see only role-relevant fields).
model CandidateDemographics {
  candidateId String @id @map("candidate_id")
  orgId       String @map("org_id")

  // protected / legal-class fields
  nationalityStatus NationalityStatus? @map("nationality_status")
  race              Race?
  ageBand           AgeBand?           @map("age_band")
  gender            Gender?

  // self-reported background
  firstLanguage    String? @map("first_language")
  yearsInSingapore Int?    @map("years_in_singapore")
  university       String?
  major            String?
  previousEmployer String? @map("previous_employer")
  yearsExperience  Int?    @map("years_experience")
  currentBase      String? @map("current_base")

  // FK includes org_id so a demographics row can only reference a candidate in
  // the same org — a cross-org mismatch is unrepresentable, not just policed.
  candidate Candidate @relation(fields: [candidateId, orgId], references: [id, orgId], onDelete: Cascade)

  // Required by Prisma to use [candidateId, orgId] as a 1:1 relation's fields.
  // Logically redundant with the candidateId primary key.
  @@unique([candidateId, orgId])
  @@index([orgId])
  @@map("candidate_demographics")
}

model Meeting {
  id                 String      @id @default(uuid())
  orgId              String      @map("org_id")
  managerId          String      @map("manager_id")
  title              String
  transcript         String
  transcriptFilename String?     @map("transcript_filename")
  date               DateTime
  // Mode flag — drives engine prompt branching, rule selection, and the
  // Decision Panel + Mirror UI splits. Existing rows backfilled to
  // 'hiring' (the only mode that existed pre-Week 5).
  meetingType        MeetingType @default(hiring) @map("meeting_type")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  org          Organisation       @relation(fields: [orgId], references: [id])
  manager      Manager            @relation(fields: [managerId], references: [id])
  candidates   MeetingCandidate[]
  flags        Flag[]
  decisions    Decision[]
  analysisRuns AnalysisRun[]

  @@index([managerId])
  @@index([orgId])
  @@map("meetings")
}

model MeetingCandidate {
  meetingId   String @map("meeting_id")
  candidateId String @map("candidate_id")

  meeting   Meeting   @relation(fields: [meetingId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@id([meetingId, candidateId])
  @@map("meeting_candidates")
}

model Decision {
  id          String          @id @default(uuid())
  orgId       String          @map("org_id")
  meetingId   String          @map("meeting_id")
  candidateId String          @map("candidate_id")
  managerId   String          @map("manager_id")
  outcome     DecisionOutcome @default(in_progress)
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  org       Organisation @relation(fields: [orgId], references: [id])
  meeting   Meeting      @relation(fields: [meetingId], references: [id])
  candidate Candidate    @relation(fields: [candidateId], references: [id])
  manager   Manager      @relation(fields: [managerId], references: [id])

  @@index([managerId])
  @@index([orgId])
  // One decision per (meeting, candidate) pair — closes the
  // duplicate-on-race window where the Flag Review decision panel could
  // POST twice before the meeting query refetched the existing decision id.
  // PATCH on the existing row stays the canonical edit path.
  @@unique([meetingId, candidateId])
  @@map("decisions")
}

model Flag {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  meetingId       String    @map("meeting_id")
  flagType        FlagType  @map("flag_type")
  excerpt         String
  reasoning       String
  confidenceScore Float     @map("confidence_score")
  suggestedAlt    String?   @map("suggested_alt")
  dismissed       Boolean   @default(false)
  dismissReason   String?   @map("dismiss_reason")
  dismissedAt     DateTime? @map("dismissed_at")
  dismissedBy     String?   @map("dismissed_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  org                Organisation @relation(fields: [orgId], references: [id])
  meeting            Meeting      @relation(fields: [meetingId], references: [id])
  dismissedByManager Manager?     @relation("DismissedBy", fields: [dismissedBy], references: [id])
  spans              FlagSpan[]

  @@index([meetingId])
  @@index([orgId])
  @@map("flags")
}

// One row per (Flag, occurrence-in-transcript). Carved out of Flag so the
// engine can record every textual hit instead of relying on the client
// to indexOf at render time — a single Flag with N occurrences becomes
// N FlagSpan rows. UI uses these as TipTap decoration ranges and the
// Found-in-N affordance.
model FlagSpan {
  id          String @id @default(uuid())
  flagId      String @map("flag_id")
  startOffset Int    @map("start_offset")
  endOffset   Int    @map("end_offset")

  flag Flag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
  @@map("flag_spans")
}

model AnalysisRun {
  id           String         @id @default(uuid())
  orgId        String         @map("org_id")
  meetingId    String         @map("meeting_id")
  status       AnalysisStatus @default(pending)
  modelVersion String?        @map("model_version")
  startedAt    DateTime?      @map("started_at")
  completedAt  DateTime?      @map("completed_at")
  error        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  org     Organisation @relation(fields: [orgId], references: [id])
  meeting Meeting      @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
  @@index([orgId])
  @@map("analysis_runs")
}
