{
  "name": "@fairhire/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "postinstall": "prisma generate --schema ../prisma/schema.prisma"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@fairhire/shared$": "<rootDir>/../../shared/dist/index.js"
    }
  },
  "dependencies": {
    "@clerk/express": "^1.3.0",
    "@fairhire/shared": "*",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "openai": "^6.38.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.0"
  }
}
